+        with self.assertRaisesRegex(module.EndpointCleanupError, 'pid 4321 survived.*SIGTERM'):
+            endpoint.stop()
+        self.assertEqual(endpoint.process.wait.call_args_list, [call(timeout=15), call(timeout=5)])
