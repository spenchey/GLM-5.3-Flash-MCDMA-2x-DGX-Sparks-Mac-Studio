+    b.region=malloc((size_t)b.region_bytes); assert(b.region);
+    memset(b.region,0x5a,(size_t)b.region_bytes);
+    build_windows(&b); fill_slots(&b,0);
+    assert(b.window_count && b.verify_effective==4096);
+    if (!strcmp(argv[2],"corrupt")) b.region[b.windows[b.window_count/2].offset]^=1;
+    else assert(!strcmp(argv[2],"good"));
+    uint64_t verified=0, mismatches=verify_windows(&b,0,&verified);
+    printf("RECEIVER op=%s role=%s verified=%" PRIu64 " mismatches=%" PRIu64 "\n",
+           argv[1],b.o.initiator?"initiator":"responder",verified,mismatches);
+    free(b.windows); free(b.region);
+    return mismatches ? 3 : 0;
+}
diff --git a/tests/verify_windows_fixture.c b/tests/verify_windows_fixture.c
new file mode 100644
index 0000000..7f8c223
--- /dev/null
+++ b/tests/verify_windows_fixture.c
@@ -0,0 +1,53 @@
+#include <inttypes.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+#include "../benchmarks/verify_windows.h"
+
+static uint64_t number(const char *text) {
+    char *end=NULL;
+    unsigned long long value=strtoull(text,&end,10);
+    if (end==text || *end) { fprintf(stderr,"bad number\n"); exit(2); }
+    return (uint64_t)value;
+}
+static void *fail_allocate(size_t count,size_t size) { (void)count; (void)size; return NULL; }
+
+int main(int argc,char **argv) {
+    if (argc==6 && !strcmp(argv[1],"effective")) {
+        uint64_t effective=0;
+        enum mcdma_verify_window_error error=mcdma_verify_effective_budget(
+            number(argv[2]),number(argv[3]),number(argv[4]),(int)number(argv[5]),&effective);
+        if (error!=MCDMA_VERIFY_OK) { printf("ERROR %s\n",mcdma_verify_window_error_name(error)); return 1; }
+        printf("EFFECTIVE bytes=%" PRIu64 "\n",effective); return 0;
+    }
+    if (argc==9 && !strcmp(argv[1],"protocol")) {
+        const int match=mcdma_verify_protocol_matches(number(argv[2]),(unsigned)number(argv[3]),(unsigned)number(argv[4]),
+                                                       (unsigned)number(argv[5]),(unsigned)number(argv[6]),number(argv[7]),number(argv[8]));
+        printf("PROTOCOL match=%d\n",match); return match ? 0 : 1;
+    }
+    const int fail_alloc=argc==5 && !strcmp(argv[1],"allocfail");
+    const int first=fail_alloc ? 2 : 1;
+    if ((!fail_alloc && argc!=4) || (fail_alloc && argc!=5)) {
+        fprintf(stderr,"usage: fixture [allocfail] SLOT_BYTES SLOTS VERIFY_BYTES\n"); return 2;
+    }
+    struct mcdma_verify_window *windows=NULL; size_t count=0;
+    enum mcdma_verify_window_error error=fail_alloc ?
+        mcdma_build_verify_windows_alloc(number(argv[first]),number(argv[first+1]),number(argv[first+2]),
+                                         &windows,&count,fail_allocate) :
+        mcdma_build_verify_windows(number(argv[first]),number(argv[first+1]),number(argv[first+2]),
+                                   &windows,&count);
+    if (error!=MCDMA_VERIFY_OK) {
+        printf("ERROR %s\n",mcdma_verify_window_error_name(error));
+        return 1;
+    }
+    uint64_t sum=0;
+    for (size_t i=0;i<count;++i) {
+        printf("WINDOW %zu offset=%" PRIu64 " length=%" PRIu64 "\n",i,windows[i].offset,windows[i].length);
+        sum+=windows[i].length;
+    }
+    printf("TOTAL count=%zu bytes=%" PRIu64 "\n",count,sum);
+    free(windows);
+    return 0;
+}
