diff --git a/tests/test_bw_pattern_trial.py b/tests/test_bw_pattern_trial.py
new file mode 100644
index 0000000..dd6120d
--- /dev/null
+++ b/tests/test_bw_pattern_trial.py
@@ -0,0 +1,260 @@
+#!/usr/bin/env python3
+import os,pathlib,selectors,shutil,subprocess,sys,tempfile,threading,time,unittest
+
+ROOT=pathlib.Path(__file__).resolve().parents[1]
+
+class PatternTrialTests(unittest.TestCase):
+    @classmethod
+    def setUpClass(cls):
+        compiler=shutil.which('clang') or shutil.which('cc')
+        if not compiler: raise unittest.SkipTest('C compiler required')
+        cls.temp=tempfile.TemporaryDirectory(); cls.binary=pathlib.Path(cls.temp.name)/'pattern-trial'
+        subprocess.run([compiler,'-std=c11','-D_POSIX_C_SOURCE=200809L','-D_DARWIN_C_SOURCE','-O1',
+                        '-Wall','-Wextra','-Werror','-fsanitize=address,undefined',
+                        str(ROOT/'tests/bw_pattern_trial.c'),'-lrdma' if sys.platform=='darwin' else '-libverbs',
+                        '-o',str(cls.binary)],check=True)
+    @classmethod
+    def tearDownClass(cls): cls.temp.cleanup()
+
+    def trial(self,operation,fault='good',wire_fault=None,trailing_delay=.015):
+        with tempfile.TemporaryDirectory() as directory:
+            shared=pathlib.Path(directory)/'shared'; region=(4<<20)+16384+64
+            shared.write_bytes(b'\x5a'*(2*region))
+            processes=[]; logs=[[],[]]; partial=[b'',b'']; final_acks=set(); attacks=[]
+            self.attack_outcomes=[]
+
+            def close_inputs():
+                for process in processes:
+                    try: process.stdin.close()
+                    except (BrokenPipeError,OSError,ValueError): pass
+
+            def delayed_attack(process,payload,delay):
+                time.sleep(delay)
+                try:
+                    process.stdin.write(payload); process.stdin.flush()
+                    self.attack_outcomes.append(('written',delay))
+                except (BrokenPipeError,OSError,ValueError):
+                    self.attack_outcomes.append(('rejected',delay))
+
+            with selectors.DefaultSelector() as selector:
+                try:
+                    for index,role in enumerate(('initiator','responder')):
+                        process=subprocess.Popen([str(self.binary),role,operation,str(shared),fault],
+                                                 stdin=subprocess.PIPE,stdout=subprocess.PIPE,stderr=subprocess.STDOUT)
+                        processes.append(process); selector.register(process.stdout,selectors.EVENT_READ,index)
+                    deadline=time.monotonic()+12
+                    while selector.get_map():
+                        self.assertLess(time.monotonic(),deadline,logs)
+                        for key,_ in selector.select(.1):
+                            index=key.data; chunk=os.read(key.fileobj.fileno(),65536)
+                            if not chunk:
+                                selector.unregister(key.fileobj)
+                                if wire_fault!='no-eof':
+                                    try: processes[1-index].stdin.close()
+                                    except (BrokenPipeError,OSError,ValueError,AttributeError): pass
+                                continue
+                            partial[index]+=chunk
+                            while b'\n' in partial[index]:
+                                line,partial[index]=partial[index].split(b'\n',1); logs[index].append(line.decode(errors='replace'))
+                                if line.startswith(b'BW_MSG '):
+                                    payload=line[7:]
+                                    complete_faults=('old','missing','duplicate','wrong-receiver','contradiction','wrong-verified')
+                                    if index==0 and payload.startswith(b'COMPLETE ') and wire_fault in complete_faults:
+                                        if wire_fault=='old': payload=payload.replace(b' v=3',b'',1)
+                                        elif wire_fault=='missing': payload=payload.rsplit(b' ',1)[0]
+                                        elif wire_fault=='duplicate': payload+=b' verified=1048576'
+                                        elif wire_fault=='wrong-receiver': payload=payload.replace(b'receiver=initiator',b'receiver=responder',1)
+                                        elif wire_fault=='contradiction': payload=payload.replace(b'mismatches=0',b'mismatches=1',1)
+                                        elif wire_fault=='wrong-verified': payload=payload.replace(b'verified=1048576',b'verified=1048568',1)
+                                        else: self.fail(f'unknown wire fault {wire_fault}')
+                                    if index==1 and payload.startswith(b'DONE ') and wire_fault and wire_fault.startswith('done-') and wire_fault!='done-repeat':
+                                        fault_name=wire_fault[5:]
+                                        if fault_name=='old': payload=payload.replace(b' v=3',b'',1)
+                                        elif fault_name=='missing': payload=payload.rsplit(b' ',1)[0]
+                                        elif fault_name=='duplicate': payload+=b' verified=1048576'
+                                        elif fault_name=='wrong-receiver': payload=payload.replace(b'receiver=responder',b'receiver=initiator',1)
+                                        elif fault_name=='wrong-verified': payload=payload.replace(b'verified=1048576',b'verified=1048568',1)
+                                        else: self.fail(f'unknown DONE wire fault {wire_fault}')
+                                    repeat=((index==0 and payload.startswith(b'COMPLETE ') and wire_fault=='repeat-complete') or
+                                            (index==1 and payload.startswith(b'DONE ') and wire_fault=='done-repeat'))
+                                    confirm=(index==0 and payload.startswith(b'CONFIRM '))
+                                    confirmed=(index==1 and payload.startswith(b'CONFIRMED '))
+                                    delay=((confirm and wire_fault=='delay-confirm') or
+                                           (confirmed and wire_fault=='delay-confirmed'))
+                                    queued=None
+                                    if confirm and wire_fault=='queued-extra-confirm': queued=b'EXTRA after=confirm\n'
+                                    elif confirmed and wire_fault=='queued-extra-confirmed': queued=b'EXTRA after=confirmed\n'
+                                    elif confirm and wire_fault=='queued-partial-confirm': queued=b'EXTRA_PARTIAL'
+                                    elif confirmed and wire_fault=='queued-partial-confirmed': queued=b'EXTRA_PARTIAL'
+                                    trailing=None
+                                    if confirm and wire_fault=='repeat-confirm': trailing=payload+b'\n'
+                                    elif confirmed and wire_fault=='repeat-confirmed': trailing=payload+b'\n'
+                                    elif confirm and wire_fault=='extra-confirm': trailing=b'EXTRA after=confirm\n'
+                                    elif confirmed and wire_fault=='extra-confirmed': trailing=b'EXTRA after=confirmed\n'
+                                    elif confirm and wire_fault=='partial-confirm': trailing=b'EXTRA_PARTIAL'
+                                    elif confirmed and wire_fault=='partial-confirmed': trailing=b'EXTRA_PARTIAL'
+                                    try:
+                                        if delay: time.sleep(.03)
+                                        processes[1-index].stdin.write(payload+b'\n'+(queued or b'')); processes[1-index].stdin.flush()
+                                        if queued is not None: self.attack_outcomes.append(('written',0))
+                                        if repeat:
+                                            time.sleep(.01)
+                                            processes[1-index].stdin.write(payload+b'\n'); processes[1-index].stdin.flush()
+                                        if trailing is not None:
+                                            attack=threading.Thread(target=delayed_attack,
+                                                                    args=(processes[1-index],trailing,trailing_delay))
+                                            attack.start(); attacks.append(attack)
+                                        if confirm: final_acks.add('CONFIRM')
+                                        if confirmed: final_acks.add('CONFIRMED')
+                                        if final_acks=={'CONFIRM','CONFIRMED'} and wire_fault!='no-eof':
+                                            close_inputs()
+                                            post_close=None
+                                            if wire_fault=='post-close-confirm': post_close=processes[1]
+                                            elif wire_fault=='post-close-confirmed': post_close=processes[0]
+                                            if post_close is not None:
+                                                try:
+                                                    post_close.stdin.write(b'EXTRA_AFTER_CLOSE\n'); post_close.stdin.flush()
+                                                    self.attack_outcomes.append(('written',0))
+                                                except (BrokenPipeError,OSError,ValueError):
+                                                    self.attack_outcomes.append(('rejected',0))
+                                    except (BrokenPipeError,OSError,ValueError): pass
+                    for attack in attacks: attack.join(timeout=1)
+                    self.assertTrue(all(not attack.is_alive() for attack in attacks))
+                    codes=[process.wait(timeout=2) for process in processes]
+                finally:
+                    for process in processes:
+                        if process.poll() is None:
+                            process.terminate()
+                            try: process.wait(timeout=2)
+                            except subprocess.TimeoutExpired: self.fail(f'surviving child pid={process.pid}')
+                        for stream in (process.stdin,process.stdout):
+                            try: stream.close()
+                            except (BrokenPipeError,OSError,ValueError,AttributeError): pass
+            return codes,logs
+
+    @staticmethod
+    def result(log):
+        return next(line for line in log if line.startswith('BW_RESULT '))
+
+    def assert_trailing_blocked_or_rejected(self,codes,logs,receiver_index):
+        self.assertEqual(len(self.attack_outcomes),1,self.attack_outcomes)
+        outcome,_=self.attack_outcomes[0]
+        if outcome=='written':
+            self.assertNotEqual(codes[receiver_index],0,logs)
+            combined='\n'.join(line for log in logs for line in log)
+            self.assertIn('BW_ERROR what=protocol_trailing_control',combined)
+        else:
+            self.assertEqual(outcome,'rejected')
+            self.assertEqual(codes,[0,0],logs)
+
+    def test_both_rows_carry_exact_receiver_proof_and_source(self):
+        for operation,receiver_index,receiver_role in (('read',0,'initiator'),('write',1,'responder')):
+            good,logs=self.trial(operation)
+            self.assertEqual(good,[0,0],logs)
+            branch=next(line for line in logs[receiver_index] if line.startswith('PATTERN_BRANCH '))
+            self.assertIn(f'role={receiver_role} receiver=1 ok=1',branch)
+            for index,source in enumerate(('local','peer') if operation=='read' else ('peer','local')):
+                result=self.result(logs[index])
+                self.assertIn('verified_bytes=1048576',result)
+                self.assertIn('mismatches=0',result)
+                self.assertIn('guard_ok=1',result)
+                self.assertIn(f'verification_source={source}',result)
+                self.assertIn(f'verification_receiver={receiver_role}',result)
+                header=next(line[14:] for line in logs[index] if line.startswith('BW_CSV_HEADER '))
+                row=next(line[7:] for line in logs[index] if line.startswith('BW_CSV '))
+                values=dict(zip(header.split(','),row.split(',')))
+                self.assertEqual(values['verified_bytes'],'1048576')
+                self.assertEqual(values['mismatches'],'0')
+                self.assertEqual(values['guard_ok'],'1')
+                self.assertEqual(values['verification_source'],source)
+                self.assertEqual(values['verification_receiver'],receiver_role)
+
+    def test_corruption_fails_both_rows_without_losing_receiver_proof(self):
+        for operation,receiver_index in (('read',0),('write',1)):
+            bad,bad_logs=self.trial(operation,'corrupt')
+            self.assertNotEqual(bad[receiver_index],0,bad_logs)
+            self.assertTrue(all(code!=0 for code in bad),bad_logs)
+            for log in bad_logs:
+                result=self.result(log)
+                self.assertIn('verified_bytes=1048576',result)
+                self.assertRegex(result,r'mismatches=[1-9][0-9]*')
+
+    def test_old_missing_duplicate_and_contradictory_complete_proof_fail(self):
+        for fault in ('old','missing','duplicate','wrong-receiver','contradiction','wrong-verified'):
+            with self.subTest(fault=fault):
+                codes,logs=self.trial('read',wire_fault=fault)
+                self.assertTrue(all(code!=0 for code in codes),logs)
+                combined='\n'.join(line for log in logs for line in log)
+                self.assertIn('BW_ERROR what=protocol_',combined)
+
+    def test_old_missing_duplicate_and_contradictory_done_proof_fail(self):
