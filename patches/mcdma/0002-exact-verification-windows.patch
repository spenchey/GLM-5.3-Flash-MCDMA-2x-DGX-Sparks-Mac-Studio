+#!/usr/bin/env python3
+import re
+import subprocess
+import tempfile
+import unittest
+from pathlib import Path
+
+
+ROOT = Path(__file__).resolve().parents[1]
+SOURCE = ROOT / "tests/verify_windows_fixture.c"
+
+
+class VerifyWindowsTest(unittest.TestCase):
+    @classmethod
+    def setUpClass(cls):
+        cls.temp = tempfile.TemporaryDirectory()
+        cls.binary = Path(cls.temp.name) / "fixture"
+        subprocess.run(["cc", "-std=c11", "-O2", "-Wall", "-Wextra", "-Werror",
+                        str(SOURCE), "-o", str(cls.binary)], check=True)
+
+    @classmethod
+    def tearDownClass(cls):
+        cls.temp.cleanup()
+
+    def run_args(self, *args, ok=True):
+        result = subprocess.run([str(self.binary), *(str(value) for value in args)],
+                                text=True, capture_output=True)
+        self.assertEqual(result.returncode, 0 if ok else 1, result)
+        return result.stdout
+
+    def run_fixture(self, slot_bytes, slots, verify, ok=True):
+        return self.run_args(slot_bytes, slots, verify, ok=ok)
+
+    def windows(self, slot_bytes, slots, verify):
+        output = self.run_fixture(slot_bytes, slots, verify)
+        windows = [(int(a), int(b)) for a, b in
+                   re.findall(r"offset=(\d+) length=(\d+)", output)]
+        total = re.search(r"TOTAL count=(\d+) bytes=(\d+)", output)
+        self.assertIsNotNone(total)
+        self.assertEqual(int(total.group(1)), len(windows))
+        self.assertEqual(int(total.group(2)), verify)
+        return windows, output
+
+    def assert_contract(self, slot_bytes, slots, verify):
+        windows, _ = self.windows(slot_bytes, slots, verify)
+        self.assertEqual(sum(length for _, length in windows), verify)
+        self.assertEqual(len(windows), len(set(windows)))
+        previous = 0
+        for index, (offset, length) in enumerate(windows):
+            self.assertEqual(offset % 8, 0)
+            self.assertEqual(length % 8, 0)
+            self.assertGreater(length, 0)
+            self.assertLessEqual(offset + length, slot_bytes * slots)
+            if index:
+                self.assertGreaterEqual(offset, previous)
+            self.assertEqual(offset // slot_bytes, (offset + length - 1) // slot_bytes)
+            previous = offset + length
+        return windows
+
+    def test_zero_is_rejected(self):
+        self.assertIn("verify_bytes_invalid_alignment_or_minimum",
+                      self.run_fixture(4096, 1, 0, ok=False))
+
+    def test_auto_budget_is_bounded_by_capacity(self):
+        self.assertIn("bytes=1048576", self.run_args("effective", 65536, 64, 0, 0))
+        self.assertIn("bytes=4096", self.run_args("effective", 4096, 1, 0, 0))
+
+    def test_default_shape_one_mib_is_exact(self):
+        self.assert_contract(65536, 16, 1 << 20)
+
+    def test_small_semantics(self):
+        for capacity, requested in ((8, 8), (16, 8), (16, 16), (4096, 8), (4096, 16)):
+            self.assertIn("verify_bytes_invalid_alignment_or_minimum",
+                          self.run_fixture(capacity, 1, requested, ok=False))
+        self.assertIn("verify_bytes_invalid_alignment_or_minimum",
+                      self.run_args("effective", 8, 1, 0, 0, ok=False))
+        self.assertEqual(sum(length for _, length in self.assert_contract(4096, 1, 24)), 24)
+
+    def test_non_multiple_is_rejected(self):
+        self.assertIn("verify_bytes_invalid_alignment_or_minimum",
+                      self.run_fixture(4096, 1, 15, ok=False))
+
+    def test_exact_p06_one_mib_has_first_middle_last(self):
+        windows = self.assert_contract(4 << 20, 1, 1 << 20)
+        self.assertEqual(len(windows), 3)
+        self.assertEqual(windows[0][0], 0)
+        self.assertLess(windows[0][0] + windows[0][1], windows[1][0])
+        self.assertLess(windows[1][0] + windows[1][1], windows[2][0])
+        self.assertEqual(windows[2][0] + windows[2][1], 4 << 20)
+        middle = windows[1][0] + windows[1][1] // 2
+        self.assertLessEqual(abs(middle - (2 << 20)), 8)
+
+    def test_capacity_boundary(self):
+        windows = self.assert_contract(4096, 3, 3 * 4096)
+        self.assertEqual(windows[0][0], 0)
+        self.assertEqual(windows[-1][0] + windows[-1][1], 3 * 4096)
+
+    def test_over_capacity_is_rejected(self):
+        self.assertIn("verify_bytes_exceed_transfer_slots",
+                      self.run_fixture(4096, 2, 8192 + 8, ok=False))
+
+    def test_deterministic_and_distributes_remaining_sample(self):
+        first, output = self.windows(4096, 4, 4096 + 24)
+        second, repeated = self.windows(4096, 4, 4096 + 24)
+        self.assertEqual(output, repeated)
+        self.assertEqual(first, second)
+        self.assertEqual(sum(length for _, length in first), 4096 + 24)
+
+    def test_arithmetic_overflow_is_rejected(self):
+        self.assertIn("verify_window_arithmetic_or_representation_overflow",
+                      self.run_fixture((1 << 64) - 8, 2, 8, ok=False))
+
+    def test_allocation_failure_is_reported(self):
+        self.assertIn("verify_windows_alloc",
+                      self.run_args("allocfail", 4096, 2, 4096, ok=False))
+
+    def test_protocol_version_and_budget_must_match(self):
+        good=(3, 0, 0, 1, 1, 1048576, 1048576)
+        self.assertIn("match=1",self.run_args("protocol",*good))
+        for index, value in ((0,1),(2,1),(4,0),(6,1048568)):
+            bad=list(good); bad[index]=value
+            self.assertIn("match=0",self.run_args("protocol",*bad,ok=False))
+
