+    const int fields=sscanf(line,
+        "DONE v=%" SCNu64 " trial=%" SCNu64 " seconds=%lf cpu_pct=%lf receiver=%15s"
+        " verified=%" SCNu64 " mismatches=%" SCNu64 " errors=%" SCNu64
+        " completions=%" SCNu64 " guard_ok=%" SCNu64 "%n",
+        &version,&wire_trial,&p.seconds,&p.cpu_pct,p.receiver,&p.verified,&p.mismatches,
+        &p.errors,&p.completions,&guard_ok,&consumed);
+    if (fields!=10 || consumed<=0 || line[consumed] || version!=MCDMA_BW_PROTOCOL_VERSION ||
+        wire_trial!=trial || !isfinite(p.seconds) || p.seconds<0 ||
+        !isfinite(p.cpu_pct) || p.cpu_pct<0 || guard_ok>1 ||
+        strcmp(p.receiver,op==OP_READ?"initiator":"responder") ||
+        p.verified!=expected || p.mismatches>p.verified/8)
+        fatal("protocol_done_receiver_proof",0);
+    p.guard_ok=(unsigned)guard_ok;
+    return p;
+}
