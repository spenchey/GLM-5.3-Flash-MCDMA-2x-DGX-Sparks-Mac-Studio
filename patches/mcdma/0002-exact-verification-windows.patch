+#!/usr/bin/env python3
+import pathlib
+import shutil
+import subprocess
+import sys
+import tempfile
+import unittest
+
+ROOT=pathlib.Path(__file__).resolve().parents[1]
+
+class VerifyReceiverTest(unittest.TestCase):
+    @classmethod
+    def setUpClass(cls):
+        compiler=shutil.which("clang") or shutil.which("cc")
+        if not compiler:
+            raise unittest.SkipTest("C compiler required")
+        cls.temp=tempfile.TemporaryDirectory()
+        cls.binary=pathlib.Path(cls.temp.name)/"receiver"
+        subprocess.run([compiler,"-std=c11","-D_POSIX_C_SOURCE=200809L","-D_DARWIN_C_SOURCE",
+                        "-O1","-Wall","-Wextra","-Werror","-fsanitize=address,undefined",
+                        str(ROOT/"tests/verify_receiver_fixture.c"),
+                        "-lrdma" if sys.platform=="darwin" else "-libverbs",
+                        "-o",str(cls.binary)],check=True)
+
+    @classmethod
+    def tearDownClass(cls): cls.temp.cleanup()
+
+    def test_read_and_write_receivers_accept_and_reject(self):
+        for operation,role in (("read","initiator"),("write","responder")):
+            good=subprocess.run([str(self.binary),operation,"good"],text=True,capture_output=True)
+            self.assertEqual(good.returncode,0,good.stdout+good.stderr)
+            self.assertIn(f"role={role}",good.stdout)
+            self.assertIn("verified=4096 mismatches=0",good.stdout)
+            bad=subprocess.run([str(self.binary),operation,"corrupt"],text=True,capture_output=True)
+            self.assertEqual(bad.returncode,3,bad.stdout+bad.stderr)
+            self.assertRegex(bad.stdout,r"mismatches=[1-9][0-9]*")
+
+if __name__=="__main__": unittest.main(verbosity=2)
