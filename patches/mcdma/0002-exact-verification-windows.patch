+/* COMPLETE is the receiver-proof handoff. Keep it ordered and exact so an old,
+ * extended, duplicate, or partially populated message cannot become success. */
+static struct trial_proof complete_proof(const char *line,unsigned trial,enum op_kind op,uint64_t expected) {
+    struct trial_proof p; memset(&p,0,sizeof(p));
+    uint64_t version=0, wire_trial=0, ok=0, guard_ok=0; int consumed=0;
+    const int fields=sscanf(line,
+        "COMPLETE v=%" SCNu64 " trial=%" SCNu64 " ok=%" SCNu64
+        " receiver=%15s proof=%7s verified=%" SCNu64 " mismatches=%" SCNu64
+        " guard_ok=%" SCNu64 "%n",
+        &version,&wire_trial,&ok,p.receiver,p.proof,&p.verified,&p.mismatches,&guard_ok,&consumed);
+    if (fields!=8 || consumed<=0 || line[consumed] || version!=MCDMA_BW_PROTOCOL_VERSION ||
+        wire_trial!=trial || ok>1 || guard_ok>1)
+        fatal("protocol_complete_fields",0);
+    p.ok=(unsigned)ok; p.guard_ok=(unsigned)guard_ok;
+    if (op==OP_READ) {
+        if (strcmp(p.receiver,"initiator") || strcmp(p.proof,"local") ||
+            p.verified!=expected || p.mismatches>p.verified/8 ||
+            (p.ok && (p.mismatches || !p.guard_ok)))
+            fatal("protocol_complete_receiver_proof",0);
+    } else if (strcmp(p.receiver,"responder") || strcmp(p.proof,"none") ||
+               p.verified || p.mismatches || p.guard_ok)
+        fatal("protocol_complete_nonreceiver_proof",0);
+    return p;
+}
