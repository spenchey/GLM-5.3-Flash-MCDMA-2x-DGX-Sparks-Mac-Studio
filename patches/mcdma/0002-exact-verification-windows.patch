+
+#define MCDMA_BW_PROTOCOL_VERSION 3u
+#define MCDMA_VERIFY_AUTO_LIMIT (UINT64_C(1) << 20)
+
+struct mcdma_verify_window { uint64_t offset, length; };
+typedef void *(*mcdma_verify_calloc_fn)(size_t, size_t);
+
+enum mcdma_verify_window_error {
+    MCDMA_VERIFY_OK = 0,
+    MCDMA_VERIFY_INVALID,
+    MCDMA_VERIFY_OVERFLOW,
+    MCDMA_VERIFY_OVER_CAPACITY,
+    MCDMA_VERIFY_ALLOCATION,
+    MCDMA_VERIFY_INTERNAL
+};
+
+static const char *mcdma_verify_window_error_name(enum mcdma_verify_window_error error) {
+    switch (error) {
+    case MCDMA_VERIFY_OK: return "ok";
+    case MCDMA_VERIFY_INVALID: return "verify_bytes_invalid_alignment_or_minimum";
+    case MCDMA_VERIFY_OVERFLOW: return "verify_window_arithmetic_or_representation_overflow";
+    case MCDMA_VERIFY_OVER_CAPACITY: return "verify_bytes_exceed_transfer_slots";
+    case MCDMA_VERIFY_ALLOCATION: return "verify_windows_alloc";
+    case MCDMA_VERIFY_INTERNAL: return "verify_windows_internal_contract";
+    }
+    return "verify_windows_unknown_error";
+}
+
+static enum mcdma_verify_window_error
+mcdma_verify_capacity(uint64_t slot_bytes, uint64_t slots, uint64_t *capacity) {
+    if (!capacity || !slot_bytes || !slots || slot_bytes % 8)
+        return MCDMA_VERIFY_INVALID;
+    if (slots > UINT64_MAX / slot_bytes)
+        return MCDMA_VERIFY_OVERFLOW;
+    *capacity = slots * slot_bytes;
+    return MCDMA_VERIFY_OK;
+}
+
+/* Auto is distinct from an explicit budget. It never caps an explicit request:
+ * it selects min(1 MiB, resident capacity). */
+static enum mcdma_verify_window_error
+mcdma_verify_effective_budget(uint64_t slot_bytes, uint64_t slots,
+                              uint64_t requested, int explicit_budget,
+                              uint64_t *effective) {
+    uint64_t capacity = 0;
+    enum mcdma_verify_window_error error = mcdma_verify_capacity(slot_bytes, slots, &capacity);
+    if (error != MCDMA_VERIFY_OK || !effective)
+        return error != MCDMA_VERIFY_OK ? error : MCDMA_VERIFY_INVALID;
+    if (!explicit_budget) {
+        *effective = capacity < MCDMA_VERIFY_AUTO_LIMIT ? capacity : MCDMA_VERIFY_AUTO_LIMIT;
+        return *effective >= 24 ? MCDMA_VERIFY_OK : MCDMA_VERIFY_INVALID;
+    }
+    if (requested < 24 || requested % 8)
+        return MCDMA_VERIFY_INVALID;
+    if (requested > capacity)
+        return MCDMA_VERIFY_OVER_CAPACITY;
+    *effective = requested;
+    return MCDMA_VERIFY_OK;
+}
+
+static enum mcdma_verify_window_error
+mcdma_build_verify_windows_alloc(uint64_t slot_bytes, uint64_t slots,
+                                 uint64_t requested,
+                                 struct mcdma_verify_window **output,
+                                 size_t *output_count,
+                                 mcdma_verify_calloc_fn allocate) {
+    uint64_t capacity = 0, effective = 0;
+    enum mcdma_verify_window_error error = mcdma_verify_capacity(slot_bytes, slots, &capacity);
+    if (error != MCDMA_VERIFY_OK || !output || !output_count || !allocate)
+        return error != MCDMA_VERIFY_OK ? error : MCDMA_VERIFY_INVALID;
+    *output = NULL;
+    *output_count = 0;
+    error = mcdma_verify_effective_budget(slot_bytes, slots, requested, 1, &effective);
+    if (error != MCDMA_VERIFY_OK)
+        return error;
+
+    const uint64_t slot_units = slot_bytes / 8;
+    const uint64_t capacity_units = capacity / 8;
+    const uint64_t requested_units = effective / 8;
+    if (slots > SIZE_MAX / 3)
+        return MCDMA_VERIFY_OVERFLOW;
+    const size_t allocation_count = (size_t)slots * 3;
+    if (!allocation_count || allocation_count > SIZE_MAX / sizeof(struct mcdma_verify_window))
+        return MCDMA_VERIFY_OVERFLOW;
+    struct mcdma_verify_window *windows = allocate(allocation_count, sizeof(*windows));
+    if (!windows)
+        return MCDMA_VERIFY_ALLOCATION;
+
+    /* Place three global first/middle/last extents. Unsampled units become two
+     * gaps; choose the first gap so the global midpoint is inside extent 2. */
+    uint64_t lengths[3]={requested_units/3,requested_units/3,requested_units/3};
+    for (uint64_t i=0;i<requested_units%3;++i) ++lengths[i];
+    const uint64_t gap_units=capacity_units-requested_units;
+    const uint64_t midpoint=capacity_units/2;
+    const uint64_t min_middle_start=midpoint>=lengths[1]-1 ? midpoint-(lengths[1]-1) : 0;
+    const uint64_t max_middle_start=midpoint;
+    const uint64_t min_gap=min_middle_start>lengths[0] ? min_middle_start-lengths[0] : 0;
+    const uint64_t max_gap=max_middle_start>=lengths[0] ? max_middle_start-lengths[0] : 0;
+    if (min_gap>max_gap || min_gap>gap_units) { free(windows); return MCDMA_VERIFY_INTERNAL; }
+    uint64_t first_gap=gap_units/2;
+    if (first_gap<min_gap) first_gap=min_gap;
+    if (first_gap>max_gap) first_gap=max_gap;
+    if (first_gap>gap_units) { free(windows); return MCDMA_VERIFY_INTERNAL; }
+    const uint64_t starts[3]={0,lengths[0]+first_gap,capacity_units-lengths[2]};
+
+    size_t count = 0;
+    uint64_t sum = 0;
+    for (unsigned piece=0;piece<3;++piece) {
+        uint64_t offset_units=starts[piece], remaining=lengths[piece];
+        while (remaining) {
+            const uint64_t within=offset_units%slot_units;
+            const uint64_t available=slot_units-within;
+            const uint64_t chunk=remaining<available ? remaining : available;
+            if (!chunk || count>=allocation_count || offset_units>UINT64_MAX/8 || chunk>UINT64_MAX/8) {
+                free(windows); return MCDMA_VERIFY_INTERNAL;
+            }
+            windows[count].offset=offset_units*8;
+            windows[count].length=chunk*8;
+            if (sum>UINT64_MAX-windows[count].length) { free(windows); return MCDMA_VERIFY_OVERFLOW; }
+            sum+=windows[count].length; ++count;
+            offset_units+=chunk; remaining-=chunk;
+        }
+    }
+    if (!count || sum != effective) {
+        free(windows);
+        return MCDMA_VERIFY_INTERNAL;
+    }
+    for (size_t i = 0; i < count; ++i) {
+        const uint64_t end = windows[i].offset + windows[i].length;
+        if (windows[i].offset % 8 || windows[i].length % 8 || end < windows[i].offset ||
+            windows[i].offset >= capacity || end > capacity ||
+            windows[i].offset / slot_bytes != (end - 1) / slot_bytes ||
+            (i && windows[i - 1].offset + windows[i - 1].length > windows[i].offset)) {
+            free(windows);
+            return MCDMA_VERIFY_INTERNAL;
+        }
+    }
+    *output = windows;
+    *output_count = count;
+    return MCDMA_VERIFY_OK;
+}
+
+static enum mcdma_verify_window_error
+mcdma_build_verify_windows(uint64_t slot_bytes, uint64_t slots, uint64_t requested,
+                           struct mcdma_verify_window **output, size_t *output_count) {
+    return mcdma_build_verify_windows_alloc(slot_bytes, slots, requested,
+                                            output, output_count, calloc);
+}
+
+static int mcdma_verify_protocol_matches(uint64_t version,
+                                         unsigned local_payload, unsigned peer_payload,
+                                         unsigned local_explicit, unsigned peer_explicit,
+                                         uint64_t local_requested, uint64_t peer_requested) {
+    return version == MCDMA_BW_PROTOCOL_VERSION &&
+           local_payload == peer_payload &&
+           local_explicit == peer_explicit &&
+           local_requested == peer_requested;
+}
+
+#endif
diff --git a/tests/bw_pattern_trial.c b/tests/bw_pattern_trial.c
new file mode 100644
index 0000000..c6af172
--- /dev/null
+++ b/tests/bw_pattern_trial.c
@@ -0,0 +1,64 @@
+/* Exercise the production pattern trial branches with shared memory replacing
+ * RDMA. The Python relay supplies only the real control messages. */
+#include <infiniband/verbs.h>
+#include <assert.h>
+#include <fcntl.h>
+#include <string.h>
+#include <sys/mman.h>
+
+static struct ibv_wc pending[128];
+static unsigned pending_head,pending_tail;
+static const char *fault;
+static int corrupted;
+
+static int copy_post(struct ibv_qp *qp,struct ibv_send_wr *wr,struct ibv_send_wr **bad) {
+    (void)qp; (void)bad; assert(pending_tail<128);
+    void *local=(void *)(uintptr_t)wr->sg_list->addr;
+    void *remote=(void *)(uintptr_t)wr->wr.rdma.remote_addr;
+    const unsigned kind=(unsigned)((wr->wr_id>>48)&0xff);
+    const int read_op=wr->opcode==IBV_WR_RDMA_READ;
+    assert(read_op || wr->opcode==IBV_WR_RDMA_WRITE);
+    memcpy(read_op?local:remote,read_op?remote:local,wr->sg_list->length);
+    if (kind==1 /* WR_DATA */ && !corrupted++ && !strcmp(fault,"corrupt"))
+        ((unsigned char *)(read_op?local:remote))[0]^=1;
+    struct ibv_wc *wc=&pending[pending_tail++];
+    wc->wr_id=wr->wr_id; wc->opcode=read_op?IBV_WC_RDMA_READ:IBV_WC_RDMA_WRITE;
+    wc->status=IBV_WC_SUCCESS;
+    return 0;
+}
+static int copy_poll(struct ibv_cq *cq,int maximum,struct ibv_wc *wc) {
+    (void)cq; int count=0;
+    while (pending_head<pending_tail && count<maximum) wc[count++]=pending[pending_head++];
+    return count;
+}
+#define ibv_post_send copy_post
+#define ibv_poll_cq copy_poll
+#define main benchmark_main
+#include "../benchmarks/mcdma_bw.c"
+#undef main
+
+int main(int argc,char **argv) {
+    assert(argc==5); setvbuf(stdout,NULL,_IOLBF,0);
+    struct bench b={0};
+    b.o.initiator=!strcmp(argv[1],"initiator");
+    b.o.op=!strcmp(argv[2],"read")?OP_READ:OP_WRITE;
+    assert(b.o.op==OP_READ || !strcmp(argv[2],"write"));
+    fault=argv[4]; assert(!strcmp(fault,"good") || !strcmp(fault,"corrupt"));
+    b.o.qps=b.cqs=1; b.o.bytes=4u<<20; b.o.depth=b.depth_local=b.depth=b.depth_effective=1;
+    b.o.total=4u<<20; b.o.repeats=1; b.o.timeout_s=1;
+    b.o.verify_explicit=1; b.o.verify_bytes=1u<<20;
+    b.cq_cap[0]=32; b.region_bytes=(4u<<20)+GUARD_BYTES+FLAG_BYTES;
+    int fd=open(argv[3],O_RDWR); assert(fd>=0);
+    unsigned char *regions=mmap(NULL,2*b.region_bytes,PROT_READ|PROT_WRITE,MAP_SHARED,fd,0);
+    assert(regions!=MAP_FAILED); close(fd);
+    b.region=regions+(b.o.initiator?0:b.region_bytes);
+    b.remote.addr=(uintptr_t)(regions+(b.o.initiator?b.region_bytes:0));
+    b.remote.length=b.region_bytes;
+    struct ibv_mr mr={0}; b.mr=&mr; b.nonce=UINT64_C(0x123456789); b.finish_imm=0;
+    build_windows(&b);
+    const int receiver=(b.o.op==OP_READ && b.o.initiator) || (b.o.op==OP_WRITE && !b.o.initiator);
+    const int ok=b.o.initiator?run_initiator_trial(&b,0,0):run_responder_trial(&b,0,0);
+    printf("PATTERN_BRANCH op=%s role=%s receiver=%d ok=%d\n",argv[2],argv[1],receiver,ok);
+    free(b.windows); assert(!munmap(regions,2*b.region_bytes));
+    return ok?0:3;
+}
