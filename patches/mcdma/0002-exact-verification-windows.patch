+        self.assertIn("verify_bytes_exceed_transfer_slots",
+                      self.run_fixture(4096,2,8200,ok=False))
+
+    def test_global_first_middle_last_for_minimum_budget(self):
+        for slots in (2, 3, 32):
+            windows=self.assert_contract(4096,slots,24)
