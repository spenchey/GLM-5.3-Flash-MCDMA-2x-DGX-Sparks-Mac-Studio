+/* Pull in bytes already waiting on stdin without consuming a future record.
+ * A second terminal record can otherwise remain buffered after the final
+ * trial and incorrectly leave the process successful. */
+static void reject_buffered_type(struct bench *b,const char *type) {
+    for (;;) {
+        fd_set set; FD_ZERO(&set); FD_SET(0,&set);
+        struct timeval tv={0,0};
+        const int ready=select(1,&set,NULL,NULL,&tv);
+        if (ready<0) { if (errno==EINTR) continue; fatal("protocol_terminal_probe",errno); }
+        if (!ready) break;
+        if (b->in.len>=sizeof(b->in.buf)) fatal("protocol_line_too_long",0);
+        const ssize_t got=read(0,b->in.buf+b->in.len,sizeof(b->in.buf)-b->in.len);
+        if (got<0) { if (errno==EINTR) continue; fatal("protocol_terminal_probe",errno); }
+        if (!got) break;
+        b->in.len+=(size_t)got;
+    }
+    const size_t type_len=strlen(type); size_t start=0;
+    while (start<b->in.len) {
+        const char *base=b->in.buf+start;
+        const char *nl=memchr(base,'\n',b->in.len-start);
+        const size_t length=nl ? (size_t)(nl-base) : b->in.len-start;
+        if (length>=type_len && !memcmp(base,type,type_len) &&
+            (length==type_len || base[type_len]==' ')) {
+            printf("BW_ERROR what=protocol_duplicate_%s\n",type); fflush(stdout); exit(2);
+        }
+        if (!nl) break;
+        start+=(size_t)(nl-base)+1;
+    }
+}
