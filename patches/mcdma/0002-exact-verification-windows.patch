+/* Close each trial with a two-message acknowledgement. Per-sender FIFO means
+ * a duplicated COMPLETE must precede CONFIRM and a duplicated DONE must
+ * precede CONFIRMED, so neither terminal record can hide after success. */
+static void final_control(struct bench *b,const char *expected,const char *duplicate,unsigned trial) {
+    char line[LINE_BYTES],kind[16]={0};
+    const int result=read_line(&b->in,line,sizeof(line),b->o.timeout_s);
+    if (result<=0) fatal("protocol_final_control_wait",0);
+    uint64_t version=0,wire_trial=0; int consumed=0;
+    const int fields=sscanf(line,"%15s v=%" SCNu64 " trial=%" SCNu64 "%n",
+                            kind,&version,&wire_trial,&consumed);
+    if (!strcmp(kind,duplicate)) {
+        printf("BW_ERROR what=protocol_duplicate_%s\n",duplicate); fflush(stdout); exit(2);
+    }
+    if (fields!=3 || consumed<=0 || line[consumed] || strcmp(kind,expected) ||
+        version!=MCDMA_BW_PROTOCOL_VERSION || wire_trial!=trial)
+        fatal("protocol_final_control_fields",0);
+}
+
+/* The controller closes both input pipes only after forwarding both valid
+ * final acknowledgements. Success therefore requires EOF, not an idle period:
+ * any complete or partial byte before EOF is a protocol violation. */
+static void final_eof_close(struct bench *b,unsigned trial) {
+    if (trial+1!=b->o.warmup+b->o.repeats) return;
+    if (b->in.len) fatal("protocol_trailing_control",0);
+    const double deadline=now_s()+b->o.timeout_s;
+    for (;;) {
+        double remaining=deadline-now_s();
+        if (remaining<=0) fatal("protocol_final_eof_wait",0);
+        fd_set set; FD_ZERO(&set); FD_SET(0,&set);
+        struct timeval tv; tv.tv_sec=(time_t)remaining;
+        tv.tv_usec=(suseconds_t)((remaining-(double)tv.tv_sec)*1e6);
+        const int ready=select(1,&set,NULL,NULL,&tv);
+        if (ready<0) { if (errno==EINTR) continue; fatal("protocol_final_eof_wait",errno); }
+        if (!ready) fatal("protocol_final_eof_wait",0);
+        char byte;
+        const ssize_t got=read(0,&byte,1);
+        if (got<0) { if (errno==EINTR) continue; fatal("protocol_final_eof_wait",errno); }
+        if (!got) return;
+        fatal("protocol_trailing_control",0);
+    }
+}
