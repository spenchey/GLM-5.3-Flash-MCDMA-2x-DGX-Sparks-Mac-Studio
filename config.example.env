# Copy to config.local.env. Keep private host details out of Git.
HEAD_SSH=spark-head
WORKER_SSH=user@192.0.2.2
STUDIO_SSH=mac-studio
GLM_RECIPE_DIR=/home/user/GLM-5.3-Flash-EXL3-2x-DGX-Sparks-TensorFold
MCDMA_STUDIO_DIR=/Users/user/Projects/MCDMA
GLM_PORT=8888
STUDIO_RDMA_DEVICE=rdma_mcrdma1
STUDIO_RDMA_INTERFACE=mcrdma1
SPARK_RDMA_DEVICE=rocep1s0f0
SPARK_RDMA_INTERFACE=enp1s0f0np0

# Three-machine TensorFold deployment. These values identify the pinned,
# already-prepared artifacts; no script downloads or silently substitutes them.
WORKER_MANAGEMENT_SSH=spark-worker
THREE_MACHINE_IMAGE=tensorfold-glm53:v0.6.0
THREE_MACHINE_IMAGE_ID=sha256:replace-with-verified-image-id
THREE_MACHINE_PATCH_LABEL=replace-with-verified-patch-label
THREE_MACHINE_METAL_LINEAR_SHA256=replace-with-verified-patched-linear-py-sha256
THREE_MACHINE_METAL_WEIGHTS_SHA256=replace-with-verified-patched-weights-py-sha256
THREE_MACHINE_CONTAINER=glm53-three-machine
THREE_MACHINE_PROJECT_DIR=/home/user/.local/share/glm53-three-machine/runtime
THREE_MACHINE_STUDIO_DIR=/Users/user/.local/share/glm53-three-machine/runtime
THREE_MACHINE_MODEL_DIR=/home/user/.cache/huggingface/hub/models--Mia-AiLab--GLM-5.3-Flash-EXL3-TR3-4bpw/snapshots/9eaebb7c4e96d983dcd538e18624622ba5b820a8
THREE_MACHINE_MODEL_CONTAINER_DIR=/root/.cache/huggingface/hub/models--Mia-AiLab--GLM-5.3-Flash-EXL3-TR3-4bpw/snapshots/9eaebb7c4e96d983dcd538e18624622ba5b820a8
THREE_MACHINE_MODEL_MANIFEST_SHA256=replace-with-verified-filename-and-size-manifest-sha256
THREE_MACHINE_MODEL_METADATA_SHA256=replace-with-verified-metadata-and-symlink-manifest-sha256
# One identical portable checkpoint is required on the Mac and both Sparks for
# an exact CUDA-prefill to MLX-decode handoff.
THREE_MACHINE_HANDOFF_CONTAINER=glm53-cache-handoff
THREE_MACHINE_NATIVE_PORTABLE_CONTAINER=glm53-portable-native
THREE_MACHINE_NATIVE_PORTABLE_PORT=8897
THREE_MACHINE_NATIVE_PORTABLE_NCCL_PORT=29642
THREE_MACHINE_CACHE_REPLAY_CONTAINER=glm53-cache-replay
THREE_MACHINE_CACHE_BUNDLE_DIR=/home/user/.local/share/glm53-three-machine/cache-bundles
THREE_MACHINE_PORTABLE_MODEL_DIR=/home/user/.cache/huggingface/hub/models--Vontra--GLM-5.3-Flash-MLX-4bit-MTP/snapshots/76add2a341a1cd90ad0e86bb69839ea9c35827c6
THREE_MACHINE_PORTABLE_MODEL_CONTAINER_DIR=/root/.cache/huggingface/hub/models--Vontra--GLM-5.3-Flash-MLX-4bit-MTP/snapshots/76add2a341a1cd90ad0e86bb69839ea9c35827c6
THREE_MACHINE_PORTABLE_MODEL_STUDIO_DIR=/Users/user/.cache/huggingface/hub/models--Vontra--GLM-5.3-Flash-MLX-4bit-MTP/snapshots/76add2a341a1cd90ad0e86bb69839ea9c35827c6
THREE_MACHINE_PORTABLE_MODEL_MANIFEST_SHA256=replace-with-verified-filename-and-size-manifest-sha256
THREE_MACHINE_PORTABLE_MODEL_METADATA_SHA256=replace-with-verified-metadata-manifest-sha256
THREE_MACHINE_PORTABLE_MODEL_CONTENT_SHA256=replace-with-verified-complete-content-manifest-sha256
THREE_MACHINE_PORTABLE_DOWNLOAD_STAGE=/home/user/.cache/glm53-portable-download-76add2a341a1cd90ad0e86bb69839ea9c35827c6
THREE_MACHINE_HEAD_DOWNLOAD_STATE=/home/user/.local/state/glm53-portable-head-download-half
THREE_MACHINE_WORKER_DOWNLOAD_STATE=/home/user/.local/state/glm53-portable-worker-download-half
THREE_MACHINE_HF_CACHE_DIR=/home/user/.cache/huggingface
THREE_MACHINE_TENSORFOLD_CACHE_DIR=/home/user/.cache/tensorfold-glm53
THREE_MACHINE_STAGE_MODEL_DIR=/Users/user/.cache/glm53-mtp-stage/76add2a341a1cd90ad0e86bb69839ea9c35827c6
THREE_MACHINE_STAGE_FILE=model-mtp-00001-of-00001.safetensors
THREE_MACHINE_STAGE_SHA256=replace-with-verified-stage-sha256
THREE_MACHINE_STAGE_MANIFEST_SHA256=replace-with-verified-stage-content-manifest-sha256
THREE_MACHINE_TENSORFOLD_SOURCE=/Users/user/.local/share/glm53-three-machine/tensorfold-v0.6.5-dflash-image
THREE_MACHINE_TENSORFOLD_SOURCE_MANIFEST_SHA256=replace-with-verified-source-content-manifest-sha256
THREE_MACHINE_DFLASH_STUDIO_DIR=/Users/user/.cache/huggingface/hub/models--incoai--GLM-5.3-Flash-DFlash2/snapshots/replace-with-reviewed-revision
THREE_MACHINE_DFLASH_MANIFEST_SHA256=replace-with-verified-dflash-content-manifest-sha256
THREE_MACHINE_STUDIO_PYTHON=/Users/user/.local/state/glm-mcdma-p07a/venv/bin/python
THREE_MACHINE_STUDIO_PYTHON_SHA256=replace-with-verified-python-executable-sha256
THREE_MACHINE_STUDIO_PYTHON_ENV=3.x.x,mlx=x.x.x,mlx-lm=x.x.x,numpy=x.x.x
THREE_MACHINE_MCDMA_LIBRARY=/Users/user/Projects/MCDMA/build/libmcdma-rpc.dylib
THREE_MACHINE_MCDMA_LIBRARY_SHA256=replace-with-verified-studio-library-sha256
THREE_MACHINE_SPARK_MCDMA_LIBRARY=/home/user/projects/MCDMA/install/lib/libmcdma-rpc.so
THREE_MACHINE_SPARK_MCDMA_LIBRARY_SHA256=replace-with-verified-spark-library-sha256
THREE_MACHINE_STUDIO_MCDMA_DAEMON=/Users/user/Projects/MCDMA/build/mcdma-rpcd
THREE_MACHINE_STUDIO_MCDMA_DAEMON_SHA256=replace-with-verified-studio-daemon-sha256
THREE_MACHINE_SPARK_MCDMA_DAEMON=/home/user/projects/MCDMA/install/bin/mcdma-rpcd
THREE_MACHINE_SPARK_MCDMA_DAEMON_SHA256=replace-with-verified-spark-daemon-sha256
THREE_MACHINE_STUDIO_TO_HEAD_SSH=spark-head
THREE_MACHINE_MCDMA_CONTROL_PORT=18620
THREE_MACHINE_STUDIO_RDMA_INDEX=0
THREE_MACHINE_SPARK_RDMA_INDEX=1
THREE_MACHINE_MAILBOX=p06cfr
THREE_MACHINE_NCCL_MASTER=192.0.2.1
THREE_MACHINE_NCCL_PORT=29631
THREE_MACHINE_HANDOFF_NCCL_PORT=29641
THREE_MACHINE_HANDOFF_PREFILL_ROWS=128
# The fast chunked Spark prompt kernel is the serving default. Set to 0 only
# for a controlled numerical-alignment experiment against the Mac kernel.
THREE_MACHINE_KDA_CHUNKED=1
# Transfer the frozen prefix cache in authenticated frames up to 256 MiB. The
# conservative 64 MiB default uses three calls; 256 MiB uses one call when the
# MCDMA reply half is also 256 MiB. The client clamps to the live reply limit.
THREE_MACHINE_HANDOFF_CHUNK_MIB=64
THREE_MACHINE_MCDMA_REQUEST_MIB=4
# Match this reply half to the largest requested frame. MCDMA accepts 4..256
# MiB in 4 MiB steps.
THREE_MACHINE_MCDMA_REPLY_MIB=64
# Match MCDMA's published split-inference path: the Mac pulls completed reply
# bytes with RDMA READ rather than relying on ordered PCIe reply writes.
THREE_MACHINE_MCDMA_PULL=1
THREE_MACHINE_NCCL_INTERFACE=enp1s0f1np1
THREE_MACHINE_NCCL_HCA=rocep1s0f1
THREE_MACHINE_L2PF=0
# TensorFold v0.6 MTP defaults. Change only one value per measured experiment.
THREE_MACHINE_MTP_DRAFTS=3
THREE_MACHINE_MTP_CONFIDENCE=0.35
# Enable only for a dedicated phase-timing benchmark. Synchronized GPU phase
# timing changes the hot path and must stay off for normal serving/baselines.
THREE_MACHINE_PHASE_TIMING=0
THREE_MACHINE_MCDMA_STATE=.state/three-machine-frame-live
THREE_MACHINE_API_HOST=127.0.0.1
THREE_MACHINE_API_PORT=8899
THREE_MACHINE_API_STATE_DIR=/Users/user/.local/state/glm53-three-machine
# Set after the one-time native capture. Benchmark and quality probes reject
# missing or mismatched reference files.
THREE_MACHINE_NATIVE_REFERENCE_SHA256=replace-with-captured-reference-sha256
